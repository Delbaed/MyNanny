# Copy to .env and fill in with values from your Firebase project settings
# (console.firebase.google.com > Project settings > General > Your apps).
# Expo automatically inlines EXPO_PUBLIC_* vars at build time.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.region.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
