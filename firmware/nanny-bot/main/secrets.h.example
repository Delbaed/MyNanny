#pragma once

// Copy this file to secrets.h (gitignored) and fill in real values so the
// robot can push its CSI status to Firebase over WiFi — no laptop/USB cable
// needed for the phone app to see it.
//
// If secrets.h does not exist, the firmware still runs exactly as before
// (WiFi CSI onboarding/following + the USB serial dashboard); it just skips
// the Firebase push.

// Firebase Realtime Database host, e.g. my-project-default-rtdb.firebaseio.com
// (no "https://"). Get it from `firebase apps:sdkconfig WEB <appId>`.
#define FIREBASE_HOST "ducklan-default-rtdb.firebaseio.com"

// Web API key for the Firebase project. This is a public identifier (safe to
// compile into firmware) — it identifies the project, it does not authorize
// access by itself.
#define FIREBASE_API_KEY "AIzaSyDUMxq7IPrESMabkXqx5Iruc2UvS_qrR1w"

// Refresh token for the pinned robot Firebase Auth identity (see
// include/secrets.h.example at the repo root for how this was created).
// database.rules.json only allows writes from that identity's uid — this
// token IS the credential that proves "I am the robot," so it's secret.
#define FIREBASE_REFRESH_TOKEN "your-robot-identity-refresh-token"

// Identifies this robot's node under /robots/<DEVICE_ID> in the database.
// Must match app/src/config/constants.ts -> DEFAULT_SETTINGS.deviceId.
#define DEVICE_ID "robot-01"
