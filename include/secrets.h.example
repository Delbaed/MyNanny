#pragma once

// Copy this file to secrets.h (gitignored) and fill in real values.
// Treat secrets.h like a password file: never commit it, never share it.

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Firebase Realtime Database host, e.g. my-project-default-rtdb.firebaseio.com
// (no "https://"). Get it from `firebase apps:sdkconfig WEB <appId>`.
#define FIREBASE_HOST "your-project-id-default-rtdb.region.firebasedatabase.app"

// Web API key for the Firebase project. This is a public identifier (safe to
// compile into firmware) — it identifies the project, it does not authorize
// access by itself.
#define FIREBASE_API_KEY "your-firebase-web-api-key"

// Refresh token for a pinned Firebase Anonymous Auth identity created just
// for this robot (see scripts/create-robot-identity, or ask the app author).
// database.rules.json only allows writes from that identity's uid — this
// token IS the credential that proves "I am the robot," so it's secret.
#define FIREBASE_REFRESH_TOKEN "your-robot-identity-refresh-token"

// Identifies this robot's node under /robots/<DEVICE_ID> in the database.
// Must match a device the app is configured to watch.
#define DEVICE_ID "robot-01"
